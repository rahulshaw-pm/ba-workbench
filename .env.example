PORT=3000

# AI_PROVIDER selects how "Draft with AI" is fulfilled: none | anthropic | azure-openai | openai | ollama
AI_PROVIDER=none

# --- anthropic ---
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-5

# --- azure-openai ---
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_DEPLOYMENT=
# AZURE_OPENAI_API_VERSION=2024-06-01

# --- openai (platform.openai.com) ---
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# --- ollama (local) ---
# OLLAMA_HOST=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.1

# Extra hostnames allowed in the Host header, comma-separated (beyond localhost/127.0.0.1 on PORT)
# ALLOWED_HOSTS=
